{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "firestore": {
      "port": 8080
    }
  },
  "hosting": {
    "target": "lamatera",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}